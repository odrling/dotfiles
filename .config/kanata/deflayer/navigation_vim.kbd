;; Vim-Navigation layer:
;;  - right: Vim-like arrows on HJKL, home/end page up/down, mouse scroll
;;  - left: one-hand shortcuts (Cmd/Ctrl-WASZXCV), Tab/Shift-Tab, prev/next
;;  - top: Super-num (i3/sway) or Alt-num (browser), zoom in/out

;; The `lrld` action stands for "live reload". This will re-parse everything
;; except for linux-dev, i.e. you cannot live reload and switch keyboard devices.

(deflayer navigation
  @pad XX   XX   XX   XX   lrld XX   XX   XX   XX   XX
  XX   @run C-S-e XX  XX        home A-a  A-l  end  XX
  lalt @wm  @ms  lsft XX        lft  down up   rght XX
  XX   XX   XX   XX   XX    _   @mwl @mwd @mwu @mwr XX
  _  _      @std            _             @num)


;; NumPad
(deflayer numpad
  _    _    _    _    _     _   _    _    _    _    _
  XX   home up   end  pgup      @/   @7   @8   @9   @+
  XX   lft  down rght pgdn      @-   @4   @5   @6   @*
  XX   XX   XX   XX   XX    _   @,   @1   @2   @3   @.
  @std  _   @std           @nbs           @0)

(deflayer wm
  _    _    _    _    _     _   _    _    _    _    _
  XX   XX   M-r  M-r  XX        XX    XX     XX     XX     XX
  M-q  lsft lsft lsft M-g       M-lft M-down M-up   M-rght @run
  XX   XX   XX   XX   XX    _   XX    M-r    M-g    XX     XX
  @std @std   @std             M-ret           @std)

(deflayer mousenav
  _    _    _    _    _     _   _    _    _    _    _
  XX   XX   M-r  M-r  XX        XX   pgdn pgup XX   XX
  XX   lsft lsft lsft XX        bck  A-j  A-k  fwd  XX
  XX   XX   XX   XX   XX    _   @mwl @mwd @mwu @mwr XX
  @std @std   @std             @std           @std)

;; function keys
(deflayer funpad
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  f1   f2   f3   f4   XX        XX   XX   XX   XX   XX
  f5   f6   f7   f8   XX        XX   lalt lctl lmet _
  f9   f10  f11  f12  XX   XX   XX   XX   XX   XX   XX
  _  _      @std           _              @std)


(defalias
  std (layer-switch base)
  pad (layer-switch numpad)
  fun (layer-switch funpad)
  wm  (layer-while-held wm)
  ms  (layer-while-held mousenav)

  ;; Mouse wheel emulation
  mwu (mwheel-up    50 120)
  mwd (mwheel-down  50 120)
  mwl (mwheel-left  50 120)
  mwr (mwheel-right 50 120))


;; vim: set ft=lisp:
