#!/sbin/openrc-run
. "${XDG_CONFIG_HOME}/rc/log.sh"

name="kanata"
description="kanata daemon"

: ${KANATA_CONFIG:=${XDG_CONFIG_HOME}/kanata/kanata.kbd}

command="kanata"
command_args="--cfg ${KANATA_CONFIG} --nodelay --no-wait --quiet"
supervisor=supervise-daemon

start_pre() {
    ebegin "Checking configuration"
        ${command} --cfg "${KANATA_CONFIG}" --check
    eend $? "Incorrect configuration file"
}
